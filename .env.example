POSTGRES_DB=travel_api
POSTGRES_USER=travel_api
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# JWT signing key, at least 32 bytes. Generate your own, never commit it.
#   Linux/macOS:  openssl rand -base64 48
#   PowerShell:   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# Access token lifetime, e.g. 30m, 24h, 7d
JWT_EXPIRATION=24h
